{
  "manifest_version": 3,
  "name": "Doubao Reader",
  "version": "0.4.0",
  "minimum_chrome_version": "109",
  "description": "A focused read-aloud player powered by Doubao Speech TTS.",
  "permissions": [
    "contextMenus",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://openspeech.bytedance.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Show Doubao Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/extractor.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-playback": {
      "suggested_key": {
        "default": "Alt+Shift+Space",
        "mac": "Alt+Shift+Space"
      },
      "description": "Play or pause the current page"
    }
  }
}
